<%- include('partials/header', { title: 'تغيير كلمة المرور' }) %>
<div class="card" style="max-width:520px;margin:2rem auto">
  <div class="card-title">🔑 تغيير كلمة المرور</div>
  <% if (forced) { %><div class="alert info">يجب تغيير كلمة المرور المؤقتة قبل المتابعة.</div><% } %>
  <% if (error) { %><div class="alert error"><%= error %></div><% } %>
  <form method="POST" action="/change-password">
    <% if (!forced) { %><div class="field"><label>كلمة المرور الحالية</label><input type="password" name="current" required></div><% } %>
    <div class="field"><label>كلمة المرور الجديدة (8 أحرف على الأقل)</label><input type="password" name="password" required minlength="8"></div>
    <div class="field"><label>تأكيد كلمة المرور</label><input type="password" name="confirm" required minlength="8"></div>
    <button class="btn">حفظ</button>
  </form>
</div>
<%- include('partials/footer') %>
