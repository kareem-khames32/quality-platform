<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>تسجيل الدخول | جودة المكالمات</title>
<link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<div class="login-wrap">
  <form class="login-card" method="POST" action="/login" autocomplete="on">
    <h1>🎧 منصة جودة المكالمات</h1>
    <% if (error) { %><div class="alert error"><%= error %></div><% } %>
    <input type="hidden" name="next" value="<%= next %>">
    <div class="field"><label>اسم المستخدم</label><input type="text" name="username" required autofocus></div>
    <div class="field"><label>كلمة المرور</label><input type="password" name="password" required></div>
    <button class="btn" style="width:100%">دخول</button>
  </form>
</div>
</body>
</html>
